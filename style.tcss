/* DeepCode — TokyoNight flat theme. */

/* ------------------------------------------------------------------ */
/* Syntax palette                                                      */
/* ------------------------------------------------------------------ */
/* Textual 8 exposes syntax token colours through TextAreaTheme, not   */
/* through TCSS properties. CodeEditor reads these $dc-* variables     */
/* from this file when it registers its editor theme.                  */
$dc-keyword: #7AA2F7;
$dc-string: #9ECE6A;
$dc-comment: #565F89;
$dc-function: #7AA2F7;
$dc-type: #2AC3DE;
$dc-number: #FF9E64;
$dc-constant: #FF9E64;
$dc-variable: #C0CAF5;
$dc-property: #73DACA;
$dc-operator: #89DDFF;
$dc-punctuation: #A9B1D6;
$dc-tag: #F7768E;
$dc-heading: #7AA2F7;
$dc-error: #F7768E;

/* ------------------------------------------------------------------ */
/* Base                                                                */
/* ------------------------------------------------------------------ */

Screen {
    background: #1A1B26;
    color: #A9B1D6;
}

MainScreen {
    background: #1A1B26;
}

#app-root {
    width: 1fr;
    height: 1fr;
    background: #1A1B26;
}

#main {
    width: 1fr;
    height: 1fr;
    background: #1A1B26;
}

/* ------------------------------------------------------------------ */
/* Sidebar: open tabs only                                             */
/* ------------------------------------------------------------------ */

#sidebar {
    width: 28;
    height: 1fr;
    background: #16161E;
}

#tabs {
    width: 1fr;
    height: 1fr;
    padding: 0;
    background: #16161E;
    scrollbar-size-vertical: 1;
    scrollbar-background: #16161E;
    scrollbar-color: #3B4261;
    scrollbar-color-hover: #565F89;
    scrollbar-color-active: #7AA2F7;
}

TabItem {
    width: 1fr;
    height: 1;
    background: #16161E;
}

TabItem:hover {
    background: #1F2335;
}

TabItem.active {
    background: #24283B;
}

TabItem.active:hover {
    background: #2A2F45;
}

.tab-name {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #A9B1D6;
    text-overflow: ellipsis;
}

TabItem.active .tab-name {
    color: #C0CAF5;
    text-style: bold;
}

.tab-close {
    width: 3;
    height: 1;
    color: #565F89;
    text-align: center;
}

.tab-close:hover {
    color: #F7768E;
    background: #24283B;
}

/* ------------------------------------------------------------------ */
/* Editor                                                              */
/* ------------------------------------------------------------------ */

#editor-area {
    width: 1fr;
    height: 1fr;
    background: #1A1B26;
}

WelcomePanel {
    width: 1fr;
    height: 1fr;
    align: center middle;
    background: #1A1B26;
}

#logo {
    width: auto;
    height: auto;
    color: #A9B1D6;
    text-align: center;
    text-wrap: nowrap;
}

#logo-hint {
    width: auto;
    height: 1;
    margin-top: 1;
    color: #565F89;
    text-align: center;
}

#logo-hint:hover {
    color: #A9B1D6;
    text-style: underline;
}

#editor {
    width: 1fr;
    height: 1fr;
    display: none;
    border: none;
    padding: 0 1;
    background: #1A1B26;
    color: #A9B1D6;
    scrollbar-background: #1A1B26;
    scrollbar-color: #3B4261;
    scrollbar-color-hover: #565F89;
    scrollbar-color-active: #7AA2F7;
}

#editor:focus {
    border: none;
}

#editor .text-area--gutter {
    color: #3B4261;
    background: #1A1B26;
}

#editor .text-area--cursor-gutter {
    color: #A9B1D6;
    background: #24283B;
    text-style: bold;
}

#editor .text-area--cursor-line {
    background: #1F2335;
}

#editor .text-area--selection {
    background: #28344A;
    color: #C0CAF5;
}

#editor .text-area--matching-bracket {
    background: #2F334D;
}

/* ------------------------------------------------------------------ */
/* Status bar                                                          */
/* ------------------------------------------------------------------ */

#status-bar {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: #16161E;
    color: #A9B1D6;
}

#status-path {
    width: 1fr;
    height: 1;
    color: #A9B1D6;
    text-overflow: ellipsis;
}

#status-position {
    width: 10;
    height: 1;
    color: #9ECE6A;
    text-align: center;
    text-style: bold;
}

#status-language {
    width: auto;
    height: 1;
    padding: 0 2 0 1;
    color: #7AA2F7;
    text-style: bold;
}

#status-encoding {
    width: 7;
    height: 1;
    color: #565F89;
    text-align: right;
}

/* ------------------------------------------------------------------ */
/* Modal dialogs                                                       */
/* ------------------------------------------------------------------ */

CommandPaletteScreen,
FileTreeScreen,
SearchScreen,
TextPromptScreen,
ConfirmCloseScreen {
    align: center middle;
    background: #000000 55%;
}

.dialog {
    background: #1A1B26;
    border: none;
    padding: 1 2;
}

.dialog-title {
    height: 1;
    color: #7AA2F7;
    text-style: bold;
}

.dialog-input {
    height: 3;
    border: none;
    padding: 0 1;
    background: #24283B;
    color: #C0CAF5;
}

.dialog-input:focus {
    border: none;
    background: #2F334D;
    color: #FFFFFF;
}

.dialog-hint {
    height: 1;
    color: #565F89;
}

Button {
    height: 3;
    min-width: 9;
    margin: 0 1;
    border: none;
    background: #24283B;
    color: #A9B1D6;
}

Button:hover {
    background: #2F334D;
    color: #C0CAF5;
}

Button:focus {
    background: #2F334D;
    color: #C0CAF5;
    text-style: bold;
}

Button.-primary {
    background: #7AA2F7;
    color: #1A1B26;
    text-style: bold;
}

Button.-primary:hover {
    background: #89DDFF;
    color: #1A1B26;
}

Button.-error {
    background: #F7768E;
    color: #1A1B26;
    text-style: bold;
}

Button.-error:hover {
    background: #FF9E64;
    color: #1A1B26;
}

/* ------------------------------------------------------------------ */
/* Command palette                                                     */
/* ------------------------------------------------------------------ */

#palette {
    width: 80;
    max-width: 95%;
    height: 80%;
    max-height: 32;
    background: #1A1B26;
}

#palette-input {
    margin-top: 1;
}

#palette-list {
    height: 1fr;
    margin-top: 1;
    background: #1A1B26;
    scrollbar-size-vertical: 1;
    scrollbar-background: #1A1B26;
    scrollbar-color: #3B4261;
    scrollbar-color-hover: #565F89;
    scrollbar-color-active: #7AA2F7;
}

.command-item {
    width: 1fr;
    height: 1;
    background: transparent;
}

.command-item:hover {
    background: #24283B;
}

.command-title {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: #A9B1D6;
}

.command-key {
    width: auto;
    height: 1;
    padding: 0 1;
    color: #565F89;
}

.command-item:hover .command-title {
    color: #C0CAF5;
}

.command-item:hover .command-key {
    color: #7AA2F7;
}

/* ------------------------------------------------------------------ */
/* Quick-open file tree                                                */
/* ------------------------------------------------------------------ */

#filetree {
    width: 90;
    max-width: 95%;
    height: 80%;
    max-height: 40;
    background: #1A1B26;
}

#file-filter {
    margin-top: 1;
}

#file-actions {
    height: 3;
    margin-top: 1;
    align: left middle;
}

#file-actions Button {
    min-width: 8;
    margin: 0 1 0 0;
}

#file-list {
    height: 1fr;
    margin-top: 1;
    background: #1A1B26;
    scrollbar-size-vertical: 1;
    scrollbar-background: #1A1B26;
    scrollbar-color: #3B4261;
    scrollbar-color-hover: #565F89;
    scrollbar-color-active: #7AA2F7;
}

.tree-row {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: transparent;
}

.tree-row:hover {
    background: #24283B;
}

.tree-row.dir {
    color: #7AA2F7;
}

.tree-row.dir:hover {
    color: #89DDFF;
}

.tree-row.file {
    color: #A9B1D6;
}

.tree-row.file:hover {
    color: #C0CAF5;
}

#tree-status {
    margin-top: 1;
    color: #565F89;
}

/* ------------------------------------------------------------------ */
/* Find / replace                                                      */
/* ------------------------------------------------------------------ */

#search {
    width: 78;
    max-width: 95%;
    height: auto;
    background: #1A1B26;
}

#find-input {
    margin-top: 1;
}

#replace-area {
    height: auto;
}

#search-status {
    margin: 0 1;
    color: #565F89;
}

#search-buttons {
    height: 3;
    align: right middle;
}

/* ------------------------------------------------------------------ */
/* Prompt / confirm                                                    */
/* ------------------------------------------------------------------ */

#prompt {
    width: 70;
    max-width: 95%;
    height: auto;
    background: #1A1B26;
}

#prompt-input {
    margin-top: 1;
}

#prompt-buttons {
    height: 3;
    margin-top: 1;
    align: right middle;
}

#confirm {
    width: 64;
    max-width: 95%;
    height: auto;
    background: #1A1B26;
}

#confirm-text {
    height: auto;
    margin: 1 0;
    color: #A9B1D6;
}

#confirm-buttons {
    height: 3;
    align: right middle;
}
